{
  "name": "ai-faq-assistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Final-year FAQ automation project with secure REST API and a presentation-ready interface",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:mongo": "node tests/mongo.integration.js",
    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.2.0",
    "playwright": "^1.63.0"
  }
}
